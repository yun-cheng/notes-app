{
  "name": "notes-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "pwa-assets-generator",
    "deploy": "npm run build && wrangler pages deploy dist --project-name notes-app --branch main",
    "dev:api": "wrangler pages dev dist --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply notes-app --local",
    "db:migrate:remote": "wrangler d1 migrations apply notes-app --remote"
  },
  "dependencies": {
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@tiptap/suggestion": "^3.33.0",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "jose": "^6.2.16",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.159.0"
  }
}
