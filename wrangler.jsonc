{
  "name": "notes-app",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Any other path is a page of the app, which finds its own way from there.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notes-app",
      "database_id": "fd354c14-41f7-47e8-9aa0-935d90d37d3a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "468133721722-vll21ap6270hafml9rc7gra71sbbmg3i.apps.googleusercontent.com"
  }
}
