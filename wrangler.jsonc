{
  "name": "notes-app",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Any other path is a page of the app, which finds its own way from there.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notes-app",
      "database_id": "fd354c14-41f7-47e8-9aa0-935d90d37d3a",
      "migrations_dir": "migrations"
    }
  ],
  // Once a day: removing expired sessions and codes (server/cleanup.ts). Every five minutes: sending due-date
  // reminders (server/reminders.ts), which need VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY set as secrets.
  // Workers AI, for translating entries where the browser can't on the device (server/translate.ts).
  "ai": { "binding": "AI", "remote": true },
  "triggers": { "crons": ["17 4 * * *", "*/5 * * * *"] },
  "vars": {
    "GOOGLE_CLIENT_ID": "468133721722-vll21ap6270hafml9rc7gra71sbbmg3i.apps.googleusercontent.com",
    // The Mac and iPhone apps sign in to Google with their own client (type iOS), in Apple's sign-in sheet.
    "GOOGLE_APPLE_CLIENT_ID": "468133721722-9vottks4ombc3lc96osecoprik89m547.apps.googleusercontent.com"
  }
}
